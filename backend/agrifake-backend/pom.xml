<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.11</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.agrifake</groupId>
	<artifactId>agrifake-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>agrifake-backend</name>
	<description>Agrifake corporate website backend API</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<!-- ===== データベース関連 ===== -->
		<!-- JPA(Hidernote)を使ったDB操作 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- PostgreSQLドライバ -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- ===== メール送信機能 ===== -->
		<!-- フォームからのメール送信処理 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!-- ===== セキュリティ ===== -->
		<!-- ログイン認証/認可 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- ===== バリデーション ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- ===== 開発補助 ===== -->
		<!-- 自動再起動など -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<!-- ===== テスト関連 ===== -->
		<!-- JUnit / Mockito などテスト用 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Spring Security用テスト -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	    <!-- Lombok -->
	    <dependency>
	        <groupId>org.projectlombok</groupId>
	        <artifactId>lombok</artifactId>
	        <optional>true</optional>
	    </dependency>
		<!-- Thymeleaf -->
		<dependency>
		    <groupId>org.springframework.boot</groupId>
		    <artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
		    <groupId>org.springframework.boot</groupId>
		    <artifactId>spring-boot-configuration-processor</artifactId>
		    <optional>true</optional>
		</dependency>
	</dependencies>
	<!--
	    ConfigurationProperties のメタデータを生成するためのプロセッサ
	    IDEでカスタムプロパティの補完・警告解消を有効にするために追加
	    実行時には不要のため optional=true
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			
	        <!-- frontend ファイルコピー -->
			<plugin>
			  <artifactId>maven-resources-plugin</artifactId>
			  <!-- <version>3.3.1</version> -->
			  <executions>
			
			    <!-- admin -->
			    <execution>
			      <id>copy-admin-static</id>
			      <phase>process-resources</phase>
			      <goals>
			        <goal>copy-resources</goal>
			      </goals>
			      <configuration>
			        <outputDirectory>${project.basedir}/src/main/resources/static/admin</outputDirectory>
			        <resources>
			          <resource>
			            <directory>${project.basedir}/../../frontend/admin/assets/js</directory>
			            <targetPath>js</targetPath>
			            <filtering>false</filtering>
			          </resource>
			          <resource>
			            <directory>${project.basedir}/../../frontend/admin/assets/css</directory>
			            <targetPath>css</targetPath>
			            <filtering>false</filtering>
			          </resource>
			          <resource>
			            <directory>${project.basedir}/../../frontend/admin/assets/images</directory>
			            <targetPath>images</targetPath>
			            <filtering>false</filtering>
			          </resource>
			        </resources>
			      </configuration>
			    </execution>
			
			    <execution>
			      <id>copy-admin-templates</id>
			      <phase>process-resources</phase>
			      <goals>
			        <goal>copy-resources</goal>
			      </goals>
			      <configuration>
			        <outputDirectory>${project.basedir}/src/main/resources/templates/admin</outputDirectory>
			        <resources>
			          <resource>
			            <directory>${project.basedir}/../../frontend/admin/components</directory>
			            <targetPath>components</targetPath>
			            <filtering>false</filtering>
			          </resource>
			          <resource>
			            <directory>${project.basedir}/../../frontend/admin/pages</directory>
			            <targetPath>pages</targetPath>
			            <filtering>false</filtering>
			          </resource>
			        </resources>
			      </configuration>
			    </execution>
			
			    <!-- common -->
			    <execution>
			      <id>copy-common-static</id>
			      <phase>process-resources</phase>
			      <goals><goal>copy-resources</goal></goals>
			      <configuration>
			        <outputDirectory>${project.basedir}/src/main/resources/static/common</outputDirectory>
			        <resources>
			          <resource>
			            <directory>${project.basedir}/../../frontend/common/assets/js</directory>
			            <targetPath>js</targetPath>
			            <filtering>false</filtering>
			          </resource>
			          <resource>
			            <directory>${project.basedir}/../../frontend/common/assets/css</directory>
			            <targetPath>css</targetPath>
			            <filtering>false</filtering>
			          </resource>
			          <resource>
			            <directory>${project.basedir}/../../frontend/common/assets/images</directory>
			            <targetPath>images</targetPath>
			            <filtering>false</filtering>
			          </resource>
			        </resources>
			      </configuration>
			    </execution>
			
			    <execution>
			      <id>copy-common-templates</id>
			      <phase>process-resources</phase>
			      <goals><goal>copy-resources</goal></goals>
			      <configuration>
			        <outputDirectory>${project.basedir}/src/main/resources/templates/common</outputDirectory>
			        <resources>
			          <resource>
			            <directory>${project.basedir}/../../frontend/common/components</directory>
			            <targetPath>components</targetPath>
			            <filtering>false</filtering>
			          </resource>
			          <resource>
			            <directory>${project.basedir}/../../frontend/common/pages</directory>
			            <targetPath>pages</targetPath>
			            <filtering>false</filtering>
			          </resource>
			        </resources>
			      </configuration>
			    </execution>
			
			    <!-- user -->
			    <execution>
			      <id>copy-user-static</id>
			      <phase>process-resources</phase>
			      <goals><goal>copy-resources</goal></goals>
			      <configuration>
			        <outputDirectory>${project.basedir}/src/main/resources/static/user</outputDirectory>
			        <resources>
			          <resource>
			            <directory>${project.basedir}/../../frontend/user/assets/js</directory>
			            <targetPath>js</targetPath>
			            <filtering>false</filtering>
			          </resource>
			          <resource>
			            <directory>${project.basedir}/../../frontend/user/assets/css</directory>
			            <targetPath>css</targetPath>
			            <filtering>false</filtering>
			          </resource>
			          <resource>
			            <directory>${project.basedir}/../../frontend/user/assets/images</directory>
			            <targetPath>images</targetPath>
			            <filtering>false</filtering>
			          </resource>
			        </resources>
			      </configuration>
			    </execution>
			
			    <execution>
			      <id>copy-user-templates</id>
			      <phase>process-resources</phase>
			      <goals><goal>copy-resources</goal></goals>
			      <configuration>
			        <outputDirectory>${project.basedir}/src/main/resources/templates/user</outputDirectory>
			        <resources>
			          <resource>
			            <directory>${project.basedir}/../../frontend/user/components</directory>
			            <targetPath>components</targetPath>
			            <filtering>false</filtering>
			          </resource>
			          <resource>
			            <directory>${project.basedir}/../../frontend/user/pages</directory>
			            <targetPath>pages</targetPath>
			            <filtering>false</filtering>
			          </resource>
			        </resources>
			      </configuration>
			    </execution>
			
			  </executions>
			</plugin>

		</plugins>
	</build>
</project>
